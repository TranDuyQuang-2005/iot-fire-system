# Copy to .env. Never commit the real file.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_SQL_PASSWORD
JWT_KEY=CHANGE_ME_TO_A_RANDOM_KEY_AT_LEAST_32_CHARACTERS
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# EMQX Cloud runtime
MQTT_MODE=cloud
MQTT_HOST=e1110a86.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_BACKEND_USERNAME=iot_backend
MQTT_BACKEND_PASSWORD=<IOT_BACKEND_PASSWORD>

# Firebase Admin (mount the real JSON into the backend container separately)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>

# Local fallback (replace the four mode/host/port/TLS values above):
# MQTT_MODE=local
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# MQTT_USE_TLS=false
